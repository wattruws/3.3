<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="katalog.AddScreen">
    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="Dodaj pozycję" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="Tytuł" />
        <TextBox Name="TitleInput" />
        <TextBlock Text="Rok wydania" />
        <TextBox Name="YearInput" />
        <TextBlock Text="Ocena (1–10)" />
        <TextBox Name="RatingInput" />
        <TextBlock Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="OnSaveClick">Zapisz</Button>
            <Button Click="OnCancelClick">Anuluj</Button>
        </StackPanel>
    </StackPanel>
</UserControl>
